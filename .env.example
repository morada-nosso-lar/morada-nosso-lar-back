# ==============================================================================
# VARIÁVEIS DE AMBIENTE - MODELO (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# ==============================================================================

# --- Autenticação JWT ---
JWT_SECRET="sua_chave_secreta_aqui"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# --- Neon PostgreSQL (via Vercel) ---
# Connection string do banco Neon. Obtenha em: Vercel Dashboard → Storage → Neon
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
